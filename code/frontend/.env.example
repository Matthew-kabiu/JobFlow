# Required by docker-compose-prod.yml. Copy to .env and set every variable.
# No fallbacks in compose or Dockerfiles; missing values will cause failures.
#
# PRODUCTION: VITE_N8N_WEBHOOK_URL is baked into the frontend at BUILD time.
# Set it to your full n8n webhook URL (e.g. https://your-n8n.app/webhook/job-search)
# in the env used when building the frontend (Coolify build env or this file before 'docker compose build').

# Frontend build — full n8n webhook URL the browser will call (must be set at build time)
VITE_N8N_WEBHOOK_URL=
