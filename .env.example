# Released images: runtime configuration only. Copy to .env.
# Unset JOBFLOW_VERSION uses latest; uncomment to pin an exact release.
# JOBFLOW_VERSION=1.0.0
PORT=8080
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# Public, runtime branding. These are not secrets and are returned to browsers.
PUBLIC_REPO_URL=https://github.com/Matthew-kabiu/JobFlow
PUBLIC_COMPANY_NAME=JobFlow
PUBLIC_COMPANY_URL=

# Optional backend-only settings. No key is needed for Himalayas or Jobicy.
HIMALAYAS_API_KEY=
# Supply only an appname approved by ReliefWeb; blank keeps it disabled.
RELIEFWEB_APPNAME=
